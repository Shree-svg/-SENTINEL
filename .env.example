# SENTINEL Environment Configuration Template
# Copy this file to .env for local overrides (never commit secrets to version control)

# Server network binding
PORT=3001
HOST=127.0.0.1

# Allowed CORS dashboard origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional Serial Port Override (leave blank for automatic port discovery)
# SERIAL_PORT=/dev/ttyUSB0
# BAUD_RATE=9600

# Telemetry & Recording settings
RECORDING_DIR=data
AUTO_RECORD=false
